<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2FB"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="110dp"
        android:text="@string/titolo"
        android:textColor="#1E88E5"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- animazione lottie del bicchiere che si riempie -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/bicchiere"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginTop="74dp"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/animazione" />

    <TextView
        android:id="@+id/testo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-38dp"
        android:text="@string/litri_zero"
        android:textColor="#333333"
        android:textSize="18sp" />

    <!-- bottone a forma di goccia, premi per bere -->
    <TextView
        android:id="@+id/bottoneBevi"
        android:layout_width="80dp"
        android:layout_height="90dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/goccia_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/bevi"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold" />

</LinearLayout>
